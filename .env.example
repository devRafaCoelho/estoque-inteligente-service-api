NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_inteligente
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRATION=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# OAuth (opcional em dev — sem isso, POST /api/auth/google|apple retorna 503)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APP_URL=http://localhost:5173

# IA (Gemini Flash — grátis no AI Studio). Sem chave = parser heurístico.
# Chave: https://aistudio.google.com/app/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-flash-latest

# Rate limit diário de IA (0 = desligado).
# Parse: cota única para texto (entrada/baixa) + foto (parse-image). Chat é separado.
AI_PARSE_DAILY_LIMIT=50
AI_CHAT_DAILY_LIMIT=40

# Upload de cupom (POST /api/intakes/parse-image)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=8

# NF-e / NFC-e (Sprint 5) — adapters SP, MG, BA
NF_PRIORITY_STATES=SP,MG,BA
# true = devolve itens mock (útil se o portal SEFAZ bloquear/captcha em dev)
NF_MOCK_COLLECTOR=false

# E-mail transacional / digest (opcional; sem SMTP os envios viram previews em arquivo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@estoque-inteligente.local
EMAIL_PREVIEW_DIR=tmp/email-previews

# Web Push (gere chaves VAPID para ativar o envio real)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@estoque-inteligente.local
